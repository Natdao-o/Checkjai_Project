# ฝั่งแอป (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ฝั่ง back-end (server/index.ts โหลดผ่าน dotenv — ถ้าไม่ใส่จะ fallback ใช้ค่า VITE_* ด้านบน)
SUPABASE_URL=
SUPABASE_ANON_KEY=
API_PORT=3001

# อ่านประวัติแบบทดสอบในหน้า Search อาจารย์ — ใช้เฉพาะใน server ห้ามเปิดใน Vite client
# ใช้คีย์ service_role / secret จาก Supabase Dashboard → Settings → API (JWT ขึ้นต้น eyJ... หรือรูปแบบ sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=
# ถ้า Dashboard ให้ชื่ออื่นหนึ่งอันเหมือนกันในด็อกเมนต์:
# SUPABASE_SERVICE_ROLE_SECRET=

